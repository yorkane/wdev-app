# codex-desktop 网关环境（systemd EnvironmentFile；KEY=value，不要写 export）

# ---- 监听 ----
HOST=127.0.0.1
PORT=3737
# 面向公网/局域网时建议把 HOST 改成 0.0.0.0，并前置一个带认证的反向代理。

# ---- 虚拟显示 ----
# 包内的 codex-desktop-xvfb.service 读同一个变量来启动 Xvfb，因此只需在这里改一次。
# 注意：宿主机若已有 Xvfb 占用该显示号，启动会失败，换成 :98 之类的空闲号即可。
DISPLAY=:99

# ---- 界面语言 ----
LANG=zh_CN.UTF-8
OPENCODEX_PREFERRED_LANGUAGES=zh-CN

# ---- 无头服务器 ----
# 设为 1 时给官方 Electron 运行时追加 --no-sandbox --headless --disable-gpu。
# 桌面环境上运行请删掉这一行（保留时行为与桌面端不同）。
OPENCODEX_HEADLESS_ELECTRON=1

# ---- 官方 Codex Desktop 运行时 ----
# 默认指向本包自带的桌面运行时（同一个 deb 交付的两个组件）。
# 也可以改成官方 deb 或社区解包目录：/usr/lib/chatgpt/resources/app.asar 等。
CODEX_DESKTOP_APP_PATH=/opt/codex-desktop/resources/app.asar
CODEX_DESKTOP_EXECUTABLE_PATH=/opt/codex-desktop/ChatGPT
CODEX_CLI_PATH=/opt/codex-desktop/resources/codex

# ---- 数据目录 ----
CODEX_HOME=/var/lib/codex-desktop/codexhome
CODEX_WEB_CONFIG_PATH=/etc/codex-desktop/config.yaml
CODEX_WEB_RUNTIME_DIR=/var/lib/codex-desktop/runtime
CODEX_WEB_REPORTS_DIR=/var/lib/codex-desktop/reports
CODEX_WEB_OFFICIAL_BUNDLE_DIR=/var/lib/codex-desktop/official-bundle
CODEX_WEB_OFFICIAL_USER_DATA_DIR=/var/lib/codex-desktop/official-user-data
