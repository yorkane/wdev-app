#!/bin/sh
# codex-desktop 网关启动器：管理 codex-desktop-gateway.service 并打开 Web 界面。
set -eu

APP_DIR=/opt/codex-desktop/gateway
ENV_FILE=/etc/codex-desktop/gateway.env
GATEWAY_UNIT=codex-desktop-gateway.service
XVFB_UNIT=codex-desktop-xvfb.service

# 从 EnvironmentFile 里读一个键的裸值（去掉首尾引号与空白）。
env_value() {
  [ -f "$ENV_FILE" ] || return 1
  sed -n "s/^[[:space:]]*$1=//p" "$ENV_FILE" | tail -1 | sed -e 's/^"//' -e 's/"$//' -e "s/^'//" -e "s/'$//"
}

gateway_url() {
  host=$(env_value HOST || true)
  port=$(env_value PORT || true)
  printf 'http://%s:%s/' "${host:-127.0.0.1}" "${port:-3737}"
}

usage() {
  cat <<'USAGE'
用法: codex-desktop-gateway <命令>

  start      启动虚拟显示与网关服务
  stop       停止网关服务（保留虚拟显示）
  restart    重启网关服务
  status     查看服务状态
  enable     开机自启（enable + 立即启动）
  disable    取消开机自启并停止
  logs [n]   查看最近 n 行日志（默认 100）
  url        打印访问地址
  open       用默认浏览器打开访问地址
  config     编辑站点配置 /etc/codex-desktop/config.yaml
  env        编辑环境配置 /etc/codex-desktop/gateway.env
  doctor     出站拦截自检：服务健康、配置、拦截活动榜、升级自检判据与临时放行建议
             （--since 1h / --top 15 / --min-count 3 / --json / --strict）
  audit [n]  查看网络审计日志最后 n 行（默认 20；审计文件路径由
             CODEX_DESKTOP_NETWORK_AUDIT_LOG 决定，缺省 /var/log/codex-desktop/network-audit.jsonl）
  version    打印已安装网关版本
USAGE
}

command="${1:-status}"
shift || true

case "$command" in
  start)
    systemctl start "$XVFB_UNIT" "$GATEWAY_UNIT"
    echo "codex-desktop gateway started -> $(gateway_url)"
    ;;
  stop)
    systemctl stop "$GATEWAY_UNIT"
    echo "codex-desktop gateway stopped"
    ;;
  restart)
    systemctl restart "$GATEWAY_UNIT"
    echo "codex-desktop gateway restarted -> $(gateway_url)"
    ;;
  status)
    systemctl --no-pager --lines=0 status "$GATEWAY_UNIT" || true
    echo "url: $(gateway_url)"
    ;;
  enable)
    systemctl enable --now "$XVFB_UNIT" "$GATEWAY_UNIT"
    echo "codex-desktop gateway enabled on boot"
    ;;
  disable)
    systemctl disable --now "$GATEWAY_UNIT" "$XVFB_UNIT"
    echo "codex-desktop gateway disabled"
    ;;
  logs)
    journalctl -u "$GATEWAY_UNIT" -n "${1:-100}" --no-pager
    ;;
  url)
    gateway_url
    echo
    ;;
  open)
    target=$(gateway_url)
    if command -v xdg-open >/dev/null 2>&1; then
      xdg-open "$target" >/dev/null 2>&1 || echo "$target"
    else
      echo "$target"
    fi
    ;;
  config)
    exec "${EDITOR:-vi}" /etc/codex-desktop/config.yaml
    ;;
  env)
    exec "${EDITOR:-vi}" /etc/codex-desktop/gateway.env
    ;;
  doctor)
    # doctor 是只读自检：用包内 node 直跑 gateway/dev/network-doctor.cjs，透传全部参数。
    if [ ! -x "$APP_DIR/node/bin/node" ]; then
      echo "codex-desktop-gateway: 找不到捆绑 node ($APP_DIR/node/bin/node)" >&2
      exit 1
    fi
    exec "$APP_DIR/node/bin/node" "$APP_DIR/gateway/dev/network-doctor.cjs" "$@"
    ;;
  audit)
    # tail 审计 JSONL；审计关闭（off/0/none）或变量缺失时回落到默认路径。
    audit_file=$(env_value CODEX_DESKTOP_NETWORK_AUDIT_LOG || true)
    case "${audit_file:-}" in
      0|off|none|"") audit_file=/var/log/codex-desktop/network-audit.jsonl ;;
    esac
    if [ -r "$audit_file" ]; then
      tail -n "${1:-20}" "$audit_file"
    else
      echo "codex-desktop-gateway: 审计文件不存在或不可读: $audit_file" >&2
      exit 1
    fi
    ;;
  version)
    cat "$APP_DIR/VERSION" 2>/dev/null || echo unknown
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "codex-desktop-gateway: 未知命令 $command" >&2
    usage >&2
    exit 2
    ;;
esac
